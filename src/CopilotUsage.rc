#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_OPTIONS DIALOGEX 0, 0, 360, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Copilot Usage Options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Access Token File (hosts.json, hosts.yml, or token file):", -1, 10, 10, 340, 12
    EDITTEXT IDC_AUTH_PATH, 10, 24, 280, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_BROWSE_AUTH, 295, 23, 55, 16

    LTEXT "Manual Token Override (optional, empty = auto-detect):", -1, 10, 44, 340, 12
    EDITTEXT IDC_TOKEN, 10, 58, 340, 14, ES_AUTOHSCROLL
    LTEXT "Leave empty to auto-detect from Windows Credential Manager (gh auth login).", -1, 10, 75, 340, 12

    LTEXT "Proxy Mode:", -1, 10, 95, 70, 12
    COMBOBOX IDC_PROXY_MODE, 85, 93, 265, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "HTTP Proxy:", -1, 10, 118, 70, 12
    EDITTEXT IDC_PROXY_SERVER, 85, 116, 265, 14, ES_AUTOHSCROLL
    LTEXT "Example: 127.0.0.1:7890 (Direct connection is recommended by default).", -1, 10, 134, 340, 12

    LTEXT "Refresh (sec):", -1, 10, 155, 70, 12
    EDITTEXT IDC_REFRESH_INTERVAL, 85, 153, 60, 14, ES_NUMBER
    LTEXT "Seconds between background quota updates (default: 60, min: 15).", -1, 150, 155, 200, 12

    DEFPUSHBUTTON "OK", IDOK, 235, 200, 55, 17
    PUSHBUTTON "Cancel", IDCANCEL, 295, 200, 55, 17
END
